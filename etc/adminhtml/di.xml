<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="YireoTraining\ExampleLokiAdminEavEntityType\Grid\ReadOnlyActionListing" type="Loki\AdminComponents\Grid\Action\ActionListing">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="search" xsi:type="object">Loki\AdminComponents\Grid\Action\SearchAction</item>
                <item name="page" xsi:type="object">Loki\AdminComponents\Grid\Action\PageAction</item>
                <item name="limit" xsi:type="object">Loki\AdminComponents\Grid\Action\LimitAction</item>
                <item name="sort" xsi:type="object">Loki\AdminComponents\Grid\Action\SortAction</item>
                <item name="filter" xsi:type="object">Loki\AdminComponents\Grid\Action\FilterAction</item>
                <item name="removeFilter" xsi:type="object">Loki\AdminComponents\Grid\Action\RemoveFilterAction</item>
                <item name="clearFilters" xsi:type="object">Loki\AdminComponents\Grid\Action\ClearFiltersAction</item>
                <item name="activeColumns" xsi:type="object">Loki\AdminComponents\Grid\Action\ActiveColumnsAction</item>
                <item name="reposition" xsi:type="object">Loki\AdminComponents\Grid\Action\RepositionAction</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="YireoTraining\ExampleLokiAdminEavEntityType\Component\Grid\ReadOnlyGridRepository" type="Loki\AdminComponents\Component\Grid\GridRepository">
        <arguments>
            <argument name="actionListing" xsi:type="object">YireoTraining\ExampleLokiAdminEavEntityType\Grid\ReadOnlyActionListing</argument>
        </arguments>
    </virtualType>
</config>
